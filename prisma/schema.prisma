generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoPago {
  PAGADO
  PENDIENTE
}

enum EstadoServicio {
  RECIBIDO
  EN_PROCESO
  LISTO_PARA_ENTREGAR
  ENTREGADO
}

enum CategoriaGasto {
  INSUMOS
  SERVICIOS_BASICOS
  ALQUILER
  SUELDOS
  MANTENIMIENTO
  VARIOS
}

enum RolUsuario {
  ADMINISTRADOR
  EMPLEADO
}

model Usuario {
  id        String      @id @default(cuid())

  nombre    String
  usuario   String      @unique
  password  String
  rol       RolUsuario  @default(EMPLEADO)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Pedido {
  id              String         @id @default(cuid())

  // Los pedidos antiguos pueden no tener número.
  // Los pedidos nuevos lo tendrán cuando se registre.
  numeroOrden     String?

  nombreCliente   String
  telefonoCliente String?

  detallePrendas  String

  montoTotal      Decimal        @db.Decimal(10, 2)
  montoAdelanto   Decimal        @default(0) @db.Decimal(10, 2)

  estadoPago      EstadoPago     @default(PENDIENTE)
  estadoServicio  EstadoServicio @default(RECIBIDO)

  fecha           DateTime       @default(now())

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([numeroOrden])
  @@index([nombreCliente])
  @@index([telefonoCliente])
  @@index([estadoServicio])
  @@index([estadoPago])
  @@index([fecha])
  @@index([createdAt])
}

model Gasto {
  id        String        @id @default(cuid())
  concepto  String
  monto     Decimal       @db.Decimal(10, 2)
  categoria CategoriaGasto
  fecha     DateTime      @default(now())

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([fecha])
  @@index([categoria])
}